#!/bin/bash
# Typortrait fleet tool -- one command per operation across all five trees.
#   tt list                     trees, ports, roles, git commit + branch + dirty count
#   tt patch <script.py> <rel>  run a patch script against <rel> in every tree
#   tt build [tree ...]         docker compose up -d --build (all, or named)
#   tt verify <needle>          HTTP code + occurrences of <needle> in served page
#
# Directory names now match their role: typortrait-stg is staging, typortrait-prod
# is production. Before 2026-08-29 production lived in a directory called
# "typortrait-staging", which was a standing invitation to edit the wrong tree.
TREES="typortrait-stg:8078:staging typortrait-prod:8077:PROD-typortrait typortrait-faithinwords:8079:PROD-faith typortrait-lovedinwords:8080:PROD-loved typortrait-pawsinwords:8081:PROD-paws"
cmd=$1; shift
case "$cmd" in
list)
  # The COMMIT is the column that matters. Branch alone once showed five identical
  # names while one tree sat three commits behind and served the old code -- a deploy
  # had skipped it and this table reported all-green. Remote name is here for the same
  # reason: a tree whose remote isn't called what the pull command says is a tree the
  # pull silently misses.
  for e in $TREES; do d=${e%%:*}; r=${e#*:}; p=${r%%:*}; o=${r#*:}
    printf '%-26s %-5s %-18s %-9s %-30s %-8s dirty=%s\n' "$d" "$p" "$o" \
      "$(git -C /root/$d rev-parse --short HEAD 2>/dev/null || echo NO-GIT)" \
      "$(git -C /root/$d rev-parse --abbrev-ref HEAD 2>/dev/null || echo NO-GIT)" \
      "$(git -C /root/$d remote 2>/dev/null | paste -sd, -)" \
      "$(git -C /root/$d status --porcelain 2>/dev/null | wc -l)"
  done ;;
patch)
  s=$1; rel=$2
  [ -n "$rel" ] || { echo "usage: tt patch <script.py> <relative/path>"; exit 2; }
  for e in $TREES; do d=${e%%:*}; printf '== %s\n' "$d"
    python3 "$s" /root/$d/typography_engine/$rel || echo "   ^ SKIPPED"
  done ;;
build)
  # Named trees must be the FULL directory name (typortrait-prod, not prod) -- that is what
  # $d holds. A name that matches nothing used to fall through silently: the loop produced
  # zero output and the script still exited 0, indistinguishable from "built everything you
  # asked for". `tt build prod faithinwords lovedinwords pawsinwords` did exactly that --
  # matched none of the five (real names all start typortrait-), built nothing, said nothing.
  # Now it counts matches and refuses to report success on zero.
  _n=0
  for e in $TREES; do d=${e%%:*}
    [ $# -eq 0 ] || echo "$*" | grep -qw "$d" || continue
    _n=$((_n+1))
    printf '== %s\n' "$d"
    ( cd /root/$d/typography_engine && docker compose up -d --build ) || echo "   ^ BUILD FAILED"
  done
  if [ $# -gt 0 ] && [ "$_n" -eq 0 ]; then
    echo "no tree matched any of: $*"
    echo "names are the FULL directory, e.g. typortrait-prod -- not 'prod'"
    exit 1
  fi ;;
verify)
  # A count of 0 from a page that never arrived is not a pass. During a rebuild the
  # container is briefly gone, curl returns nothing, grep counts 0, and an absent tree
  # reads exactly like a clean one. So the count is only reported for a 200; anything
  # else says so and is worth re-running once the tree is up.
  for e in $TREES; do d=${e%%:*}; r=${e#*:}; p=${r%%:*}
    body="$(curl -s -w '\n%{http_code}' http://127.0.0.1:$p/static/index.html)"
    code="${body##*$'\n'}"
    if [ "$code" = "200" ]; then hits="$(printf '%s' "${body%$'\n'*}" | grep -c "$1")"
    else hits="n/a -- no page"; fi
    printf '%-26s %-5s http=%-4s hits=%s\n' "$d" "$p" "$code" "$hits"
  done ;;
*) sed -n '2,7p' "$0" ;;
esac
