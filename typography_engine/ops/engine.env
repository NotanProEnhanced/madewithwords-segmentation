# The engine's settings, one file for every tree.  ops/sync-engine-env.sh writes this
# block into each tree's .env, replacing whatever that tree had for these keys, so the
# same photo renders byte-identically on every site. Everything else in a tree's .env --
# its identity, keys, ports, prices, feature switches such as TYPO_WOVEN -- is not touched.
#
# A key with a value is set on every tree. A key left EMPTY (KEY=) is owned and unset:
# the sync removes it from every tree so the engine's own default applies. That is how
# the twenty hand-tuned LovedInWords switches were retired on 2026-09-17: judged by eye
# against the defaults on the same matte, no visible difference (journal).
#
# Decided 2026-09-17, on the twelve-photo human set, by eye: the ISNet matte unioned with
# the person segmenter keeps both the hair and the clothes (C); the engine's defaults for
# the rest. Change a value here, sync, and gate -- never in a tree's .env by hand.

# ---- Lifelike (people): the matte -------------------------------------------------------
TYPO_MATTE_MODEL=isnet
TYPO_MATTE_UNION=1
TYPO_MATTE_FLOOR=
TYPO_MATTE_GAMMA=
TYPO_MATTE_MAXSIDE=
TYPO_MATTE_ALPHA=
TYPO_SOFT_MATTE=
TYPO_SEG_PAD=0.22
TYPO_FACE_ANCHORED_MATTE=
TYPO_FACE_FLOOR=
TYPO_FACE_FLOOR_GROW=
TYPO_FACE_REGION=
TYPO_MASK_FILL_MAXCOV=
TYPO_MASK_FILL_SMALL=
TYPO_MASK_GROW=

# ---- Lifelike: ink, eyes, tone (the values Typortrait ran; the rest at the defaults) -----
TYPO_EYE_PLAIN=1
TYPO_INK_LIFT=1.62
TYPO_INK_LIFT_ADD=28
TYPO_IRIS_ALPHA=0.88
TYPO_IRIS_MIN_PX=4
TYPO_MISFIT_GAP=0.035
TYPO_SUBJECT_BASE=1.0
TYPO_SUBJECT_DIM=0.30
TYPO_BG_LIGHTEN=
TYPO_CREASE=
TYPO_DARKSCLERA=
TYPO_DEPOSTERIZE=
TYPO_EDGE_FALLOFF=
TYPO_EYE_PHOTO=
TYPO_EYE_POP=
TYPO_EYE_SHARPEN=
TYPO_FACE_DETAIL=
TYPO_HILIGHT_FINE=
TYPO_HILIGHT_WASH=
TYPO_INK_SAT=
TYPO_IRIS_LIFT=
TYPO_LENS_DARKRATIO=
TYPO_LENS_DARK_MAX=
TYPO_NOIR_CONTRAST=
TYPO_PAPER_FACE=
TYPO_PAPER_HAIR=
TYPO_POLARITY=
TYPO_POLARITY_FLOOR=
TYPO_POLARITY_GAMMA=
TYPO_POLARITY_INK_FLOOR=
TYPO_POLARITY_PEDESTAL=
TYPO_IDLE_UNLOAD_S=
TYPO_RASTERIZER=
TYPO_SAT_CAP=
TYPO_SHADOW_LIFT=
TYPO_VIBRANCE=
TYPO_WORD_EYES=
TYPO_WORD_VARIETY=
TYPO_AUTOLEVELS=

# ---- The watermark on previews ----------------------------------------------------------
TYPO_WM_ALPHA=70
TYPO_WM_GAP=1.4
TYPO_WM_SCALE=0.020

# ---- Debug and dump switches: never on a tree ------------------------------------------
TYPO_ARGS_DEBUG=
TYPO_DUMP_FIELDS=
TYPO_EYE_DEBUG=
TYPO_TEETH_DEBUG=
TYPO_MASK_DEBUG=
TYPO_OPS_PREVIEW_PX=
PET_LM_DEBUG=
PET_LANDMARKS=
PET_HOLE_DEBUG=

# ---- The pet engine (PawsInWords, and the Natural style on the human sites) ------------
TYPO_LAYERED_PHOTO=1
TYPO_LENS_SIZE=
PET_ENGINE=v2
PET_V2_VERBOSE=1
PET_V2_MAX_RENDER_PX=
PET_V2_HAIR_REVEAL=
PET_V2_LANDMARKS=
PET_DEWHISKER=0.85
PET_DRAPE=110
PET_DRAPE_DETAIL_DAMP=1.0
PET_DRAPE_SMOOTH=0.036
PET_EDGE_INK=0.62
PET_FEATURE_FILL=0.03
PET_FEATURE_PROTECT=1.0
PET_FEATURE_SCOPE=0.06
PET_HERO_CENTRE=0.8
PET_LOCAL_CONTRAST=0.65
PET_MAX_RENDER_PX=3000
PET_NEGATIVE_SPACE=0.55
PET_PHOTO=0.15
PET_PHOTO_FUR=0
PET_ROW_GAP=1.15
PET_SHADOW_LIFT=1.4
PET_SUBJECT_BASE=0.85
PET_SUBJECT_DIM=0.28
PET_TIER_COARSE=64
PET_TIER_GAMMA=0.85
PET_TONAL=0.35
PET_VIGNETTE=0
PET_WORD_TIERS=1
PET_MATTE_MODEL=
PET_MATTE_FILL=
PET_HOLE_MAX=
PET_TORSO_FILL=

# Owned since 2026-09-18:
#   TYPO_LAYERED_PHOTO=1  routes Mosaic/Passage (Original ink) through the Lifelike engine;
#                         every container already carried 1 (base compose default), so
#                         this only makes it explicit. 0 restores the layered route.
#   TYPO_LENS_SIZE=       the sunglasses lens scale in the Lifelike renderer (not a page
#                         setting). PawsInWords ran 0.9, the other four 1.0. Unset = 1.0.
# Not owned here, deliberately:
#   TYPO_WOVEN, PET_TEST, TYPO_GATHER_ENABLED, TYPO_GALLERY_ENABLED, TYPO_REDEEM_*: feature
#                        switches a tree turns on for itself.
