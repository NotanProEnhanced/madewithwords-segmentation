# FaithInWords Painterly Rendering Config
# Old master paintings rendered with scripture — muted, artistic, dramatic
# Copy to ~/typortrait-staging/typography_engine/.env (when serving FaithInWords)

# =============================================================================
# FAITH IN WORDS — PAINTERLY AESTHETIC (OLD MASTERS + SCRIPTURE)
# =============================================================================

# ---- FEATURE FLAGS ----------------------------------------------------------

# Crowd-sourced words collection (feature flag)
TYPO_GATHER_ENABLED=1

# Pre-made collections gallery (feature flag)
TYPO_GALLERY_ENABLED=1

# Redemption codes (feature flag)
TYPO_REDEEM_ENABLED=1

# ---- INPUT QUALITY RECOVERY -------------------------------------------------

# Auto-levels: recover flat/low-contrast uploads
TYPO_AUTOLEVELS=1

# ---- RENDERING ENGINE SELECTION -------------------------------------------

# Layered photographic rendering: ON for all styles
TYPO_LAYERED_PHOTO=1

# Backdrop choice for layered rendering
TYPO_LAYERED_BACKDROP=gray

# ---- TYPOGRAPHY QUALITY ---------------------------------------------------

# Word-variety dial: flatten lead-word repetition
TYPO_WORD_VARIETY=0.70

# ---- BACKGROUND & COMPOSITION -----------------------------------------------

# Background lightening: moderate for painting separation
TYPO_BG_LIGHTEN=0.55

# Paper/ink ground floors (painterly palette)
TYPO_PAPER_FACE=0.30
TYPO_PAPER_HAIR=0.35

# ---- SKIN TONE & COLOUR FIDELITY — PAINTERLY MUTED -------------------------

# Highlight wash: preserve painted highlights without over-brightening
# 0.65 = brighten highlights in paintings (INCREASED from 0.55)
TYPO_HILIGHT_WASH=0.65

# Shadow lift: keep dramatic painted shadows (not lifted like photos)
# 0.15 = minimal lift; preserve chiaroscuro (REDUCED from 0.28)
TYPO_SHADOW_LIFT=0.15

# Vibrance: SUPPRESS saturation to preserve muted old-master palette
# 0.12 = very muted; old paintings have subdued color (REDUCED from 0.30)
TYPO_VIBRANCE=0.12

# Oversaturation ceiling: prevent garish colors in paintings
TYPO_SAT_CAP=150

# Ink saturation multiplier
TYPO_INK_SAT=1.02

# De-posterize: emphasize painted brushstroke texture
# 0.80 = smooth falloff reveals brushwork (INCREASED from 0.65)
TYPO_DEPOSTERIZE=0.80

# ---- EYE RENDERING — PAINTERLY SOFT ----------------------------------------

# Photographic eye-overlay opacity: paintings don't have photorealistic eyes
# 1.0 = KEEP full photo eye (paintings often have subtle eye detail)
TYPO_EYE_PHOTO=1.0

# Eye crispness: paintings don't have photorealistic sharpness
# 0.30 = soft eye rendering; not graphic (REDUCED from 0.70)
TYPO_EYE_SHARPEN=0.30

# Eye pop: paintings have painted eyes, not catchlights/rims
# 0.50 = subtle definition (REDUCED from 0.85)
TYPO_EYE_POP=0.50

# Iris colour fallback lift: paintings have subtle iris detail
# 1.15 = minimal lift; preserve painting's iris tone (REDUCED from 1.45)
TYPO_IRIS_LIFT=1.15

# Sunglasses backstop: suppress fabricated eyes on dark lenses
TYPO_DARKSCLERA=1

# Sunglasses detection ratio
TYPO_LENS_DARKRATIO=0.62

# Sunglasses frame darkness threshold
TYPO_LENS_DARK_MAX=115

# Misfit-mesh guard
TYPO_MISFIT_GAP=0.02

# Word-formed eyes: OFF (use photographic)
TYPO_WORD_EYES=0

# ---- FACE DETAIL & DEFINITION — PAINTERLY SOFT FOCUS ----------------------

# Face-detail sizing: paintings have softer feature definition
TYPO_FACE_DETAIL=0.95

# Micro-expression: paintings don't render facial creases graphically
# 0.12 = minimal creasing (REDUCED from 0.22)
TYPO_CREASE=0.12

# Highlights breathe: finer type in bright areas
# 0.25 = less pronounced than photographs (REDUCED from 0.35)
TYPO_HILIGHT_FINE=0.25

# Light-aware far-edge softening: paintings often have soft edges
# 0.45 = KEEP (paintings benefit from directional softening)
TYPO_EDGE_FALLOFF=0.45

# ---- HAIR & MATTING ---------------------------------------------------------

# Soft hair matte: feather edges for painterly quality
TYPO_SOFT_MATTE=1

# High-quality matting model: strand-level detail
TYPO_MATTE_MODEL=1

# Matte model resolution cap
TYPO_MATTE_MAXSIDE=1280

# Matte edge cleanup: slightly higher floor for painterly rendering
# 0.15 = softer edges (INCREASED from 0.10)
TYPO_MATTE_FLOOR=0.15

# Matte gamma: sharpness of edge
TYPO_MATTE_GAMMA=1.5

# ---- POLARITY & CONTRAST — PAINTERLY DRAMA --------------------------------

# Lifelike polarity: ON — paintings have dramatic tonal contrast
TYPO_POLARITY=1

# Polarity gamma: hardness of shadow type (paintings = dramatic)
# 1.50 = harder shadows for painting drama (INCREASED from 1.35)
TYPO_POLARITY_GAMMA=1.50

# Polarity floor: darkest type value in shadow
TYPO_POLARITY_FLOOR=0.18

# Noir contrast: shadow intensity for chiaroscuro effect
# 1.25 = dramatic shadows like paintings (INCREASED from 1.08)
TYPO_NOIR_CONTRAST=1.25

# ---- DIAGNOSTICS & ADVANCED ------------------------------------------------

# Eye detection debugging
TYPO_EYE_DEBUG=0

# SVG->PNG backend
TYPO_RASTERIZER=auto

# ---- PERFORMANCE (OPTIONAL) -------------------------------------------------

# Render concurrency
# TYPO_RENDER_CONCURRENCY=

# Worker processes
# UVICORN_WORKERS=1

# Async queue
# TYPO_ASYNC_QUEUE=

# Async threshold
# TYPO_ASYNC_THRESHOLD=20
