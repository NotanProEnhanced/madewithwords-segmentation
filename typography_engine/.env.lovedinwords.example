# LovedInWords.com — environment for the memorial studio + EverLoved redemption store.
#
# EASIEST PATH: copy prod's real .env (it already has your Stripe/Printful/SMTP/SECRET
# values), then apply the OVERRIDES below so this container is LovedInWords, not prod:
#
#   cp /root/typortrait/typography_engine/.env  /root/typortrait-lovedinwords/typography_engine/.env
#   nano /root/typortrait-lovedinwords/typography_engine/.env      # set the 4 overrides
#
# --- REQUIRED OVERRIDES (change these after copying prod's .env) --------------
TYPO_PUBLIC_URL=https://lovedinwords.com      # so redeem links + emails point here
TYPO_REDEEM_ENABLED=1                          # turns on the /redeem (EverLoved) flow
TYPO_REDEEM_BRAND=keepsake                     # the LovedInWords / EverLoved skin
PRINTFUL_CONFIRM=false                         # DRAFT orders until you prove the flow
#
# --- These come from prod's .env (do NOT invent new values) ------------------
# TYPO_SECRET_KEY=      signs the redeem cookie + one-time download links (keep prod's)
# TYPO_SMTP_USER=       sends the issue_code email + admin "redeemed" notice
# TYPO_SMTP_PASS=
# TYPO_ADMIN_EMAIL=     where the admin "redemption fulfilled" alert lands
# TYPO_ADMIN_PASSWORD=  admin login for this container
# PRINTFUL_API_TOKEN=   fulfills the framed / family-set prints
# PRINT_URL_SECRET=     signs the art-fetch URL Printful downloads from
#
# --- Optional: direct on-site checkout (NOT needed for EverLoved redemption) --
# Redemption never charges, so Stripe is optional here. Leave these EMPTY to run an
# EverLoved-only store (direct on-site buying stays off); or paste prod's LIVE Stripe
# key + a lovedinwords.com webhook secret to also sell directly on the site.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
