# =============================================================================
# STAGING environment template.
#
# Copy this to `.env` IN THE STAGING WORKING TREE only
# (e.g. ~/typortrait-staging/typography_engine/.env) and fill in TEST values.
# This template is committed; the real .env is git-ignored and never leaves the
# server. Production keeps its own separate .env — do not mix them.
#
# Golden rules for staging:
#   * Stripe TEST keys only (sk_test_... / whsec_... from the test dashboard).
#     NEVER put live keys here. Test card: 4242 4242 4242 4242, any future date.
#   * PRINTFUL_CONFIRM=false  -> physical orders become deletable DRAFTS (no
#     charge, no print) so you can inspect product + art safely.
#   * Use a DIFFERENT admin password + session secret than production.
#   * Leave UMAMI_WEBSITE_ID blank so test traffic never hits prod analytics.
# =============================================================================

# Public URL of the staging mirror (Stripe redirects + Printful art URLs use it)
TYPO_PUBLIC_URL=https://staging.typortrait.com

# --- Stripe (TEST MODE ONLY) -------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Optional: only needed if you wire a Stripe test webhook (digital checkout does
# not require it). Leave blank otherwise.
STRIPE_WEBHOOK_SECRET=
TYPO_PRICE_CENTS=1499
TYPO_CURRENCY=usd

# --- Printful (drafts only on staging) ---------------------------------------
# Keep PRINTFUL_CONFIRM=false so nothing is ever actually printed/charged.
PRINTFUL_CONFIRM=false
# Optional: a real Printful token lets you exercise draft creation. Safe with
# PRINTFUL_CONFIRM=false (orders land as deletable drafts). Leave blank to keep
# staging digital-only.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Any random string; signs the time-limited /printful-fetch art URLs.
PRINT_URL_SECRET=REPLACE_ME_random_staging_string

# --- Admin dashboard (use values DIFFERENT from production) -------------------
TYPO_ADMIN_PASSWORD=REPLACE_ME_staging_admin_password
TYPO_ADMIN_EMAIL=
TYPO_SECRET_KEY=REPLACE_ME_random_staging_session_secret

# --- SMTP (optional; blank = no notification emails on staging) --------------
TYPO_SMTP_USER=
TYPO_SMTP_PASS=

# --- Analytics OFF on staging ------------------------------------------------
# Leave blank so staging never sends events to the production Umami site.
UMAMI_WEBSITE_ID=
