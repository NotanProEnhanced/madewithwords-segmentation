# LovedInWords Memorial Rendering Config
# Photorealistic memorial tributes — intimate, respectful, photographic
# Copy to ~/typortrait-staging/typography_engine/.env (when serving LovedInWords)

# =============================================================================
# LOVED IN WORDS — PHOTOREALISTIC MEMORIAL AESTHETIC
# =============================================================================

# ---- FEATURE FLAGS ----------------------------------------------------------

# Crowd-sourced words collection (feature flag)
TYPO_GATHER_ENABLED=1

# Pre-made collections gallery (feature flag)
TYPO_GALLERY_ENABLED=1

# Redemption codes (feature flag)
TYPO_REDEEM_ENABLED=1

# ---- INPUT QUALITY RECOVERY -------------------------------------------------

# Auto-levels: recover flat/low-contrast uploads (critical for personal photos)
TYPO_AUTOLEVELS=1

# ---- RENDERING ENGINE SELECTION -------------------------------------------

# Layered photographic rendering: ON for photorealistic quality
TYPO_LAYERED_PHOTO=1

# Backdrop choice for layered rendering
TYPO_LAYERED_BACKDROP=gray

# ---- TYPOGRAPHY QUALITY ---------------------------------------------------

# Word-variety dial: flatten lead-word repetition for readability
TYPO_WORD_VARIETY=0.70

# ---- BACKGROUND & COMPOSITION -----------------------------------------------

# Background lightening: separate subject from background
TYPO_BG_LIGHTEN=0.55

# Paper/ink ground floors for memorial aesthetic
TYPO_PAPER_FACE=0.30
TYPO_PAPER_HAIR=0.35

# ---- SKIN TONE & COLOUR FIDELITY — PHOTOREALISTIC MEMORIAL ----------------

# Highlight wash: keep bright features (silver hair, pale skin) light
# 0.55 = strong lift for luminous appearance
TYPO_HILIGHT_WASH=0.55

# Shadow lift: preserve modelled detail in shaded side
# 0.28 = strong preservation of facial structure
TYPO_SHADOW_LIFT=0.28

# Vibrance: saturate subject tones for life and presence
# 0.30 = luminous, living quality appropriate for memorial
TYPO_VIBRANCE=0.30

# Oversaturation ceiling: prevent garish lips/skin
TYPO_SAT_CAP=150

# Ink saturation multiplier
TYPO_INK_SAT=1.02

# De-posterize: smooth light->dark falloff for natural skin
# 0.65 = smooth gradations, life-like appearance
TYPO_DEPOSTERIZE=0.65

# ---- EYE RENDERING — PHOTOREALISTIC MEMORIAL --------------------------------

# Photographic eye-overlay opacity: full photorealistic eye (truthful)
# 1.0 = preserve real eye color and detail as remembrance
TYPO_EYE_PHOTO=1.0

# Eye crispness: sharp, alive eyes
# 0.70 = crisp eyes without over-processing
TYPO_EYE_SHARPEN=0.70

# Eye pop: crisp catchlight + dark iris rim for presence
# 0.85 = sharp definition so eyes feel alive
TYPO_EYE_POP=0.85

# Iris colour fallback lift: brighten brown eyes for recognition
# 1.45 = strong lift so eye color reads true
TYPO_IRIS_LIFT=1.45

# Sunglasses backstop: suppress fabricated eyes on dark lenses
# DISABLED for LovedInWords: photorealistic memorial doesn't need lens suppression;
# TYPO_EYE_PHOTO=1.0 preserves real eyes regardless. Disabling prevents any dark-lens
# logic from interfering with genuine eye rendering on memorial portraits.
TYPO_DARKSCLERA=0

# Sunglasses detection ratio
TYPO_LENS_DARKRATIO=0.62

# Sunglasses frame darkness threshold
TYPO_LENS_DARK_MAX=115

# Misfit-mesh guard
TYPO_MISFIT_GAP=0.02

# Word-formed eyes: OFF (photographic eyes preserve truth of remembrance)
TYPO_WORD_EYES=0

# ---- FACE DETAIL & DEFINITION — PHOTOREALISTIC MEMORIAL --------------------

# Face-detail sizing: fine type on whole face for feature recognition
TYPO_FACE_DETAIL=0.95

# Micro-expression: render subtle facial character (creases, laugh lines)
# 0.22 = life's marks rendered respectfully as fine type
TYPO_CREASE=0.22

# Highlights breathe: finer type in bright skin areas
# 0.35 = delicate rendering of light areas
TYPO_HILIGHT_FINE=0.35

# Light-aware far-edge softening: fade shadow-side silhouette gracefully
# 0.45 = respectful edge treatment
TYPO_EDGE_FALLOFF=0.45

# ---- HAIR & MATTING ---------------------------------------------------------

# Soft hair matte: feather edges so hair reads natural, not cut-out
TYPO_SOFT_MATTE=1

# High-quality matting model: strand-level hair detail (excellent for silver/light hair)
TYPO_MATTE_MODEL=1

# Matte model resolution cap
TYPO_MATTE_MAXSIDE=1280

# Matte edge cleanup: clean gaps between hair strands
# 0.10 = tight, clean edges
TYPO_MATTE_FLOOR=0.10

# Matte gamma: sharpens low-alpha edge
TYPO_MATTE_GAMMA=1.5

# ---- POLARITY & CONTRAST — PHOTOREALISTIC MEMORIAL --------------------------

# Lifelike polarity: ON — dark type in shadows for depth
TYPO_POLARITY=1

# Polarity gamma: hardness of shadow type
# 1.35 = well-defined shadows for three-dimensional appearance
TYPO_POLARITY_GAMMA=1.35

# Polarity floor: darkest type value in shadow
TYPO_POLARITY_FLOOR=0.18

# Noir contrast: shadow intensity for dimension
# 1.08 = subtle drama for photorealistic memorial quality
TYPO_NOIR_CONTRAST=1.08

# ---- DIAGNOSTICS & ADVANCED ------------------------------------------------

# Eye detection debugging
TYPO_EYE_DEBUG=0

# SVG->PNG backend
TYPO_RASTERIZER=auto

# ---- PERFORMANCE (OPTIONAL) -------------------------------------------------

# Render concurrency
# TYPO_RENDER_CONCURRENCY=

# Worker processes
# UVICORN_WORKERS=1

# Async queue
# TYPO_ASYNC_QUEUE=

# Async threshold
# TYPO_ASYNC_THRESHOLD=20
