# Complete Pet Rendering Optimization Config — Typography-First
# Your current settings tuned for WORDS FIRST, photo as form/color underneath
# Copy to ~/typortrait-staging/typography_engine/.env

# =============================================================================
# PET RENDERING — TYPOGRAPHY-FIRST OPTIMIZATION (15 SETTINGS)
# =============================================================================

# Enable pet test page for staging diagnostics
PET_TEST=1

# ---- FOREGROUND SEGMENTATION ------------------------------------------------

# Matte solidification: keep whole subject (prevents "floating head" on white fur)
# Threshold to keep low-confidence areas (0.35 = keep regions above 35% confidence)
PET_MATTE_FILL=0.35

# ---- TYPOGRAPHY & SPACING ---------------------------------------------------

# Type scale: 0.38 = fine, emphasizes detail-tier type on features
# Your choice for crisp, defined rendering
PET_TYPE_SCALE=0.38

# Letter tracking: space between letters (1.0 = baseline)
# Opens type so it reads less like a solid mass; prevents crowding
PET_TRACK=1.0

# Row gap: spacing between text rows (1.12x line height)
# Gives text room to breathe; prevents busy/solid appearance
PET_ROW_GAP=1.12

# ---- FORM & WARPING ---------------------------------------------------------

# Drape depth: form-following warp intensity (100 = moderate)
# Type follows subject's luminance contours for sculptural effect
PET_DRAPE=100

# Drape field smoothing: blur on warp field (0.045 = subtle)
# Balances smooth form-following with crisp features
# Too low = sharp edges cause type shearing; too high = lost form
PET_DRAPE_SMOOTH=0.045

# ---- FEATURE PROTECTION (EYES/NOSE) -----------------------------------------

# Feature protection: shield eyes/nose from over-processing (0.7 = strong)
# Compact features (eyes, nose) are detected + protected from de-whisker
# Whiskers/thin strokes still removed from body; features stay intact
PET_FEATURE_PROTECT=0.7

# De-whisker strength: remove whisker/ear-line artifacts (0.95 = aggressive)
# Your choice for clean, readable rendering without noise
PET_DEWHISKER=0.95

# Eye pop: catchlight + iris rim definition (0.8 = strong)
# Adds crisp eye definition ON TOP of photographic blend
# Makes soft/low-res sources read alive instead of flat/muddy
PET_EYE_POP=0.8

# ---- SUBJECT PHOTOGRAPHIC BLENDING — TYPOGRAPHY-FIRST ----------------------

# Photo blending: how much subject's actual colours remain (0.52 = type-forward)
# REDUCED from 0.7 to make WORDS PRIMARY
# 0.52 = type dominates, photo shapes form + adds color underneath
# Buyer sees typography they paid for, not a photo they already have
PET_PHOTO=0.52

# Fur texture detail: texture used for fine-type placement (0.28 = minimal)
# REDUCED from 0.5 to minimize photo texture competing with type
# 0.28 = enough texture so features drive fine-type tier, but type reads clearly
# Higher values = more fur texture visible (photographic); lower = cleaner type
PET_PHOTO_FUR=0.28

# Shadow lift: preserve shaded body detail (0.80 = strong)
# Recovers modelled detail in dark fur/shadowed neck instead of crushing to ground
PET_SHADOW_LIFT=0.80

# ---- CONTRAST & TONE --------------------------------------------------------

# Local contrast: prevent muddy rendering on body (0.4 = moderate)
# Applied before final composite so type sits crisp against ground
# Low = flat body; high = over-sharpened texture noise
PET_LOCAL_CONTRAST=0.4

# Tonal depth: overall darkness/contrast range (0.95 = strong)
# 0 = flat grey; 1.0 = full black-to-white. Maximizes tonal separation.
PET_TONAL=0.95

# Vibrance: saturate subject to pop against ground (0.80 = strong) ← BOOSTED
# Brings colour life to type rendering, not photographic detail
# Increased from 0.75 to emphasize color in typography
PET_VIBRANCE=0.80

# ---- EDGE DEFINITION — TYPOGRAPHY-FIRST SHARPNESS --------------------------

# Edge ink: internal edges as ink lines (0.95 = very strong) ← BOOSTED
# Darkens type edges so words read crisp and defined
# Increased from 0.90 to maximize type readability over photo detail
PET_EDGE_INK=0.95

# Edge tightening: sharpen silhouette edges (0.3 = moderate)
# Counteracts soft matte feathering for defined subject outline
PET_EDGE_TIGHTEN=0.3

# Sharpness: edge crispness without halo (0.50 = strong) ← BOOSTED
# Makes type edges crisp so words POP off the ground
# Increased from 0.42 to prioritize type definition over soft photo
PET_SHARPEN=0.50

# ---- RENDERING SAFETY -------------------------------------------------------

# Max rendering resolution (pixels): cap for print speed safety
# Full 4500px print takes ~70s (past proxy timeout).
# Render at this cap, then upscale finished portrait to print size (LANCZOS4).
# 2400 = ~17s per render; meets print quality targets
PET_MAX_RENDER_PX=2400
