# Optimized Staging Environment for Pet Rendering Excellence
# Copy this to ~/typortrait-staging/typography_engine/.env when setting up staging

# =============================================================================
# STAGING CONFIGURATION — TEST KEYS & STAGING SETTINGS
# =============================================================================

# Public URL of the staging mirror (Stripe redirects + Printful art URLs use it)
TYPO_PUBLIC_URL=https://staging.typortrait.com

# --- Stripe (TEST MODE ONLY) -------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=
TYPO_PRICE_CENTS=1499
TYPO_CURRENCY=usd

# --- Printful (drafts only on staging) ---------------------------------------
PRINTFUL_CONFIRM=false
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
PRINT_URL_SECRET=REPLACE_ME_random_staging_string

# --- Admin dashboard (use values DIFFERENT from production) -------------------
TYPO_ADMIN_PASSWORD=REPLACE_ME_staging_admin_password
TYPO_ADMIN_EMAIL=
TYPO_SECRET_KEY=REPLACE_ME_random_staging_session_secret

# --- SMTP (optional; blank = no notification emails on staging) --------------
TYPO_SMTP_USER=
TYPO_SMTP_PASS=

# --- Analytics OFF on staging ------------------------------------------------
UMAMI_WEBSITE_ID=

# =============================================================================
# PET RENDERING OPTIMIZATION — PAWS IN WORDS PEAK QUALITY
# =============================================================================

# Enable testing of pet rendering on staging (allows /pet-test page)
PET_TEST=1

# Foreground segmentation: isnet-general-use (superior to u2net on fur edges)
# Switched from u2net after commit 0509c94 for better white-on-white handling
PET_MATTE_MODEL=isnet

# Solidify matte to prevent "floating head" on light fur (keep threshold)
PET_MATTE_FILL=0.35

# Protect eye/nose interiors from de-whisker processing (feature field strength)
# Prevents corruption of eyes while still removing whisker artifacts
PET_FEATURE_PROTECT=0.7

# De-whisker strength: removes whisker/ear-line artifacts but preserves compact features
# After commit 0992a8d (fix eye/nose "melt"): tuned for feline subjects
PET_DEWHISKER=0.85

# Local contrast enhancement to prevent muddy renderings
# Applied before final composite so type sits crisp against ground
PET_LOCAL_CONTRAST=0.4

# Row gap multiplier: 1.12 gives text breathing room (lines don't collide)
# <1.0 = crowded/busy; >1.2 = sparse/airy
PET_ROW_GAP=1.12

# Letter tracking: 1.0 is baseline, <1 = compressed, >1 = spaced
# Subtle spacing opens the type up (reads less like solid mass)
PET_TRACK=1.0

# Drape field smoothing: amount of blur applied to luminance-warp field
# Low = sharp local edges (creates shearing); high = lost form.
# 0.045 balances form-following type with crisp features
PET_DRAPE_SMOOTH=0.045

# Base type scale: subject occupies whole height as reference = 900px
# 0.42 (medium) = balanced fine type on features + coarse on body
# <0.30 = tiny/fussy; >0.56 = coarse/blocky (use form-follower slider instead)
PET_TYPE_SCALE=0.42

# Rendering resolution cap (pixels): high-quality print safety limit
# Full 4500px print takes ~70s (past proxy timeout). Render at this cap,
# then upscale finished portrait to print size using LANCZOS4.
# 2400 = ~17s per render, meets print quality targets
PET_MAX_RENDER_PX=2400

# Eye catchlight protection: photographic eye blending factor (0..1)
# Higher = pure photo eye; lower = type blend-through for form-following
# Set per-brand via UI slider in production; staging default 0.5
PET_EYE_POP=0.8

# Shadow lift: preserve modelled detail in shaded fur/body (0..1)
# 0 = crush to ground; 0.7 = lift without losing form
PET_SHADOW_LIFT=0.7

# Vibrance: saturate subject against the ground (0..1)
# After commit 5ad60d5 (buyer-excitement pass): 0.6-0.7 for hero shine
PET_VIBRANCE=0.65

# Tonal depth: final image darkness/contrast (0..1)
# 0 = flat grey; 1.0 = full black-to-white range
PET_TONAL=0.95

# Edge-ink strength: render internal edges (eyes, nose, muzzle line) as ink (0..1)
# After commit 257d01f (fix eye/nose "melt"): 0.4 preserves detail without over-inking
PET_EDGE_INK=0.4

# Photo blend for fur/features: how much subject's actual colours remain (0..1)
# 0 = pure typed portrait; 1.0 = photographic subject through type
# 0.7 keeps subject recognizable while reading as typography
PET_PHOTO=0.7

# Sharpness enhancement: crisp edges without halo (0..1)
# 0.3-0.4 makes eyes pop; >0.5 introduces artifacts
PET_SHARPEN=0.35

# Vignette fade: darken edges to focus on subject (0..1)
# 0.1-0.15 frames without obvious effect; >0.3 looks styled
PET_VIGNETTE=0.12

# Photo detail for fine type placement: how much actual texture is preserved (0..1)
# Higher = finer type on fur texture; lower = coarser, cleaner type
PET_PHOTO_FUR=0.6

# Edge tightening: sharpen silhouette edges (0..1)
# Counteracts soft matte feathering; 0.3 = natural, 0.6 = crisp cutout
PET_EDGE_TIGHTEN=0.3
