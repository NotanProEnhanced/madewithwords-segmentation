# Complete Human Rendering Optimization Config
# Your current TYPO_* settings + incremental polish for exceptional quality
# Copy to ~/typortrait-staging/typography_engine/.env

# =============================================================================
# HUMAN RENDERING — COMPREHENSIVE OPTIMIZATION (30+ SETTINGS)
# =============================================================================

# ---- FEATURE FLAGS ----------------------------------------------------------

# Crowd-sourced words collection (feature flag)
TYPO_GATHER_ENABLED=1

# Pre-made collections gallery (feature flag)
TYPO_GALLERY_ENABLED=1

# Redemption codes (gift/partner/pre-need) (feature flag)
TYPO_REDEEM_ENABLED=1

# ---- INPUT QUALITY RECOVERY -------------------------------------------------

# Auto-levels: recover flat/low-contrast uploads (per-channel stretch + gamma)
# ON: restores colour internal luma stretch can't reach
TYPO_AUTOLEVELS=1

# ---- RENDERING ENGINE SELECTION -------------------------------------------

# Layered photographic rendering: Words + Message styles on Original ink
# through the Lifelike (displacement) engine. ON = all styles share photo quality
TYPO_LAYERED_PHOTO=1

# Backdrop choice for layered rendering
TYPO_LAYERED_BACKDROP=gray

# ---- TYPOGRAPHY QUALITY ---------------------------------------------------

# Word-variety dial: flatten lead-word repetition so varied lists read varied
# 0.0 = original engine (byte-identical); 0.70 = flattened variety
TYPO_WORD_VARIETY=0.70

# ---- BACKGROUND & COMPOSITION -----------------------------------------------

# Background lightening: render background lighter than subject's dark ground
# 0.55 = moderate lightening for subject separation
TYPO_BG_LIGHTEN=0.55

# Paper/ink ground floors so faces + light hair read on ivory background
TYPO_PAPER_FACE=0.30
TYPO_PAPER_HAIR=0.35

# ---- SKIN TONE & COLOUR FIDELITY -------------------------------------------

# Highlight wash: keep bright features (silver hair, pale skin) light on ground
# so they don't collapse to ground. 0.55 = strong lift for luminous appearance
TYPO_HILIGHT_WASH=0.55

# Shadow lift: preserve modelled detail in shaded side (cheeks, jaw, neck)
# 0.28 = strong detail preservation (INCREASED from 0.18 for depth)
TYPO_SHADOW_LIFT=0.28

# Vibrance: saturate subject tones for life without oversaturation
# 0.30 = stronger saturation (INCREASED from 0.22 for luminous skin)
TYPO_VIBRANCE=0.30

# Oversaturation ceiling (HSV S; 0 off). Prevents garish lips/skin
TYPO_SAT_CAP=150

# Colour desaturation strength in ink rendering
TYPO_INK_SAT=1.02

# De-posterize: add smooth light->dark falloff so face isn't flat/banded
# 0.65 = smoother gradations (INCREASED from 0.6 for natural skin)
TYPO_DEPOSTERIZE=0.65

# ---- EYE RENDERING ----------------------------------------------------------

# Photographic eye-overlay opacity: how much real eye stays visible vs type blend
# 1.0 = full photorealistic eye (truthful eye color, real iris detail)
TYPO_EYE_PHOTO=1.0

# Eye crispness: sharpen + local contrast inside eye (scaled for small eyes)
# 0.70 = crisp eyes (KEEPING your value, above default 0.6)
TYPO_EYE_SHARPEN=0.70

# Eye pop: paint crisp catchlight + dark iris rim ON TOP of photo eye
# so soft/low-res sources still read alive and defined (not flat/muddy)
# 0.85 = strong definition (INCREASED from 0.80 for pop)
TYPO_EYE_POP=0.85

# Iris colour fallback lift: brighten low-saturation (brown) iris on dark ground
# 1.45 = strong lift for brown eyes (INCREASED from 1.35 for more definition)
TYPO_IRIS_LIFT=1.45

# Sunglasses backstop: suppress fabricated eyes on dark lenses (auto)
TYPO_DARKSCLERA=1

# Sunglasses detection ratio: trigger only on frames darker than this p90
TYPO_LENS_DARKRATIO=0.62

# Sunglasses frame darkness threshold (p90 basis): only darken if darker than this
TYPO_LENS_DARK_MAX=115

# Misfit-mesh guard: suppress face whose iris sits above brow (sunglasses/occluded)
TYPO_MISFIT_GAP=0.02

# Word-formed eyes: OFF = photographic eyes (truthful); ON = word-formed eyes
# (OFF is correct: photographic eyes avoid iris-colour + sunglasses artefacts)
TYPO_WORD_EYES=0

# ---- FACE DETAIL & DEFINITION -----------------------------------------------

# Face-detail sizing: lift text density on whole face so chin, cheekbones, ears
# render as FINE type — distinct from larger neck below
TYPO_FACE_DETAIL=0.95

# Micro-expression: render facial creases (folds, crow's feet) as fine type
# 0.22 = subtle creases (keeps character without harshness)
TYPO_CREASE=0.22

# Highlights breathe: finer type in brightest skin so highlights don't cake
# 0.35 = finer type on bright areas (INCREASED from 0.30 for delicate rendering)
TYPO_HILIGHT_FINE=0.35

# Light-aware far-edge softening: fade SHADOW-side silhouette into ground
# (self-gates — flat lighting = no effect). 0.45 = subtle directional softening
TYPO_EDGE_FALLOFF=0.45

# ---- HAIR & MATTING ---------------------------------------------------------

# Soft hair matte: feather subject/background edge (guided-filter alpha)
# so hair doesn't read as cardboard cutout. ON = feathered edges
TYPO_SOFT_MATTE=1

# High-quality matting model: RobustVideoMatting for true strand-level hair
# ON = strand-level detail (your choice; excellent for hair quality)
TYPO_MATTE_MODEL=1

# Matte model resolution cap (max side length for inference)
TYPO_MATTE_MAXSIDE=1280

# Matte edge cleanup: drop alpha below FLOOR to 0 (clean gaps), then GAMMA sharpens
# 0.10 = cleaner background gaps (DECREASED from 0.12 for tighter edges)
TYPO_MATTE_FLOOR=0.10

# Matte gamma: sharpens low-alpha edge (more = sharper boundary)
TYPO_MATTE_GAMMA=1.5

# ---- POLARITY & CONTRAST ---------------------------------------------------

# Lifelike polarity: dense dark type in shadow (a black to lean into)
# ON = darker type in shadowed areas; OFF = type fades to ground
TYPO_POLARITY=1

# Polarity gamma: hardness of shadow type (>1 = harder shadows, more contrast)
# 1.35 = well-defined shadows (keeps drama without harshness)
TYPO_POLARITY_GAMMA=1.35

# Polarity floor: darkest type value in shadow (0 = true-black gaps, 1 = grey)
TYPO_POLARITY_FLOOR=0.18

# Noir contrast: shadow intensity multiplier for dramatic effect
# 1.08 = subtle drama (slight shadow darkening for depth)
TYPO_NOIR_CONTRAST=1.08

# ---- DIAGNOSTICS & ADVANCED ------------------------------------------------

# Eye detection debugging: set to 1 to log per-face eye/lens detection to stderr
TYPO_EYE_DEBUG=0

# SVG->PNG backend: auto (CairoSVG, full fidelity) | resvg (faster)
TYPO_RASTERIZER=auto

# ---- PERFORMANCE (OPTIONAL) -------------------------------------------------

# Render concurrency (internal thread management)
# TYPO_RENDER_CONCURRENCY=

# Worker processes: multiplier on throughput (1 = default; set higher for load-testing)
# UVICORN_WORKERS=1

# Async queue: capture-first queue for spike overflow (feature flag)
# TYPO_ASYNC_QUEUE=

# Async threshold: triggers queue when request load exceeds this
# TYPO_ASYNC_THRESHOLD=20
