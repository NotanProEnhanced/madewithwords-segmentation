# Dev scratch at engine root: render comparisons, tuning scripts, baselines
# (anchored with a leading / so app/pipeline/__init__.py etc. are NOT matched)
/_*.png
/_*.py
/_*.json
/source.png
/margot_baseline_ember.png
/Margot-Source.JPG
/marketing/index-org.html

# lovedinwords gallery: raw source photos + working renders. The deployed picks
# ({name}-before.jpg / {name}-after.png) ARE committed; these working dirs are not.
marketing/lovedinwords/_src/
marketing/lovedinwords/_gallery/

# Local timestamped backups — git history is the real backup
*.bak
*.bak-*
*-backup-*.html

# Admin Studio (local batch generator) — credentials + generated output, never deployed.
# Glob the staging dirs: each collection stages in its own (_gallery_out, _gallery_out_xmas,
# ...) and they hold the full-size sellable MASTERS, which must never enter git.
tools/admin_studio.env
tools/_gallery_out*/
tools/_sacred_src*/
