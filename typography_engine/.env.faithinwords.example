# FaithInWords.com storefront — environment. Copy to `.env` in the FaithInWords tree
# and fill in the values. This is a LIVE public storefront, so use LIVE Stripe keys
# once you're ready to sell (start with PRINTFUL_CONFIRM=false to prove the flow first).
#
#   cp .env.faithinwords.example .env   &&   nano .env

TYPO_PUBLIC_URL=https://faithinwords.com

# --- Payments (Stripe) -------------------------------------------------------
# LIVE secret key (sk_live_...) to actually sell. Add a Stripe webhook endpoint at
# https://faithinwords.com/webhook/stripe and paste its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Fulfillment (Printful) ---------------------------------------------------
# Shared with your existing store is fine — each container submits its own orders.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Signs the one-time art-fetch URL Printful downloads the master from.
PRINT_URL_SECRET=
# START false = draft orders (no charge/print) while you test. Set true to fulfill real prints.
PRINTFUL_CONFIRM=false

# --- Gallery storefront ------------------------------------------------------
# This container IS the gallery; the compose defaults it on, but set it explicitly too.
TYPO_GALLERY_ENABLED=1

# --- Admin + signing ---------------------------------------------------------
# Its OWN admin login + secret (can differ from prod). TYPO_SECRET_KEY signs admin
# sessions + the signed print/download URLs. Generate one: openssl rand -hex 32
TYPO_ADMIN_PASSWORD=
TYPO_ADMIN_EMAIL=
TYPO_SECRET_KEY=

# --- Email (order/admin notifications) — optional ----------------------------
TYPO_SMTP_USER=
TYPO_SMTP_PASS=

# --- Analytics — optional ----------------------------------------------------
UMAMI_WEBSITE_ID=

# --- Pricing / currency (defaults are fine) ----------------------------------
TYPO_CURRENCY=usd
