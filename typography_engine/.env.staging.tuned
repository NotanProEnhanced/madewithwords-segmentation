# Tuned Pet Rendering Config — Stylized Type + Sharp Subject Recognition
# Preserves your aesthetic while restoring photographic clarity

# =============================================================================
# CORE PET RENDERING (Tuned for Exceptional Quality)
# =============================================================================

# Enable pet rendering test page on staging
PET_TEST=1

# Foreground segmentation: isnet-general-use (superior fur/white-on-white)
PET_MATTE_MODEL=isnet

# Type scale: 0.38 = finer than default, emphasizes detail-tier type
# (Your choice; balanced at 0.42, finer at 0.35)
PET_TYPE_SCALE=0.38

# Drape depth: form-following warp intensity (100 = moderate, 120 = deep)
# Your 100 is conservative; keeps type readable while following subject contours
PET_DRAPE=100

# Edge definition: strong internal edges (eyes, nose, muzzle) as ink lines
# Your 0.8 creates graphic quality; 0.4 is more painterly. Keeping yours.
PET_EDGE_INK=0.8

# CRITICAL FIX: Subject photo blending
# OLD: 0.55 → subject colors heavily desaturated (muddy/washed out)
# NEW: 0.72 → subject pops through type while staying stylized
# (Still type-forward, but subject is sharp & recognizable)
PET_PHOTO=0.72

# CRITICAL FIX: Fur texture for detail-tier sizing
# OLD: 0.05 → almost no texture; fine type can't "read" features
# NEW: 0.55 → enough texture so eyes/nose/fur drive fine-type placement
# (Keeps stylized look; restores feature clarity)
PET_PHOTO_FUR=0.55

# De-whisker strength: aggressive removal (0.95) removes artifacts
# Keeping your preference for clean, type-readable rendering
PET_DEWHISKER=0.95

# =============================================================================
# OPTIONAL: Additional Tuning (Use These if Rendering Still Needs Adjustment)
# =============================================================================

# If edges feel too harsh: lower from 0.8 → 0.6
# If subject colors still muddy: raise from 0.72 → 0.75
# If eyes/nose not sharp enough: raise from 0.55 → 0.65

# Matte solidification (prevent floating head on white fur)
PET_MATTE_FILL=0.35

# Feature protection (eyes/nose from over-processing)
PET_FEATURE_PROTECT=0.7

# Local contrast (prevent muddy type on body)
PET_LOCAL_CONTRAST=0.4

# Row gap (text breathing room)
PET_ROW_GAP=1.12

# Letter tracking (space between words)
PET_TRACK=1.0

# Drape field smoothing (balance form + crisp features)
PET_DRAPE_SMOOTH=0.045

# Rendering resolution cap (pixel safety limit for print)
PET_MAX_RENDER_PX=2400

# Shadow lift (preserve shaded body detail)
PET_SHADOW_LIFT=0.7

# Vibrance (saturate subject against ground)
PET_VIBRANCE=0.65

# Tonal depth (image darkness/contrast)
PET_TONAL=0.95

# Eye pop (catchlight + iris rim definition)
PET_EYE_POP=0.8

# Sharpness (edge crispness without halo)
PET_SHARPEN=0.35

# Vignette (edge darkening for focus)
PET_VIGNETTE=0.12

# Edge tightening (sharpen silhouette)
PET_EDGE_TIGHTEN=0.3
